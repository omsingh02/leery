{
  "name": "leery",
  "version": "1.0.0",
  "description": "Leery — a realtime multiplayer bluffing card game. Lie, call it, clear your hand. React + Supabase.",
  "author": {
    "name": "Om Singh",
    "url": "https://github.com/omsingh02"
  },
  "license": "MIT",
  "homepage": "https://leery.omsingh.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omsingh02/leery.git"
  },
  "bugs": {
    "url": "https://github.com/omsingh02/leery/issues"
  },
  "keywords": [
    "card-game",
    "bluffing",
    "multiplayer",
    "realtime",
    "supabase",
    "postgres",
    "react",
    "typescript",
    "vite",
    "tailwindcss"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "dev:api": "node scripts/dev-api.mjs",
    "e2e": "playwright test",
    "dev:ui": "vite --open /dev/game.html?state=turn-mine"
  },
  "dependencies": {
    "@fontsource-variable/inter": "~5.3.0",
    "@fontsource-variable/unbounded": "~5.3.0",
    "@radix-ui/react-dialog": "~1.1.14",
    "@supabase/supabase-js": "~2.117.2",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "framer-motion": "~12.43.0",
    "lucide-react": "~0.577.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "react-router-dom": "~7.18.4",
    "sonner": "~1.7.4",
    "tailwind-merge": "~2.6.0",
    "tailwindcss-animate": "~1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@playwright/test": "~1.63.0",
    "@types/node": "~22.20.5",
    "@types/pg": "~8.23.1",
    "@types/react": "~18.3.23",
    "@types/react-dom": "~18.3.7",
    "@vitejs/plugin-react-swc": "~3.11.0",
    "autoprefixer": "~10.6.1",
    "eslint": "~9.32.0",
    "eslint-plugin-react-hooks": "~5.2.0",
    "eslint-plugin-react-refresh": "~0.5.7",
    "globals": "~15.15.0",
    "pg": "~8.23.1",
    "postcss": "~8.5.6",
    "tailwindcss": "~3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.71.0",
    "vite": "~6.4.3",
    "vitest": "~4.1.11"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
